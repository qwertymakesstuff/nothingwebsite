{
  // Cloudflare Worker "missing-play" (play.missing.website): a static arcade, served from ./public.
  // In Cloudflare (Workers & Pages > your worker > Settings > Build): Root directory = play
  // The Worker's name in Cloudflare must match the name below.
  "name": "nothingplay",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  // Attach the custom domain on deploy (Cloudflare creates the DNS record and certificate).
  "routes": [
    { "pattern": "play.missing.website", "custom_domain": true }
  ]
}
