{
  // Test-only config for @cloudflare/vitest-pool-workers: same Worker and Durable Objects as
  // ../../wrangler.jsonc, minus the static site and custom domain (no build needed to test).
  "name": "rookery-test",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-23",
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "TOURNAMENT", "class_name": "Tournament" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Lobby"] },
    { "tag": "v3", "new_sqlite_classes": ["Tournament"] }
  ],
  "vars": { "SUPABASE_URL": "http://localhost:54321" }
}
