{
  "name": "rookery",
  "private": true,
  "description": "Rookery: an online chess platform (chess.missing.website)",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @rookery/web",
    "dev:realtime": "wrangler dev",
    "build": "npm run build -w @rookery/web",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "wrangler": "^4.168.0"
  }
}
