{
  // Cloudflare Worker "missing-music" (music.missing.website).
  //  - static player files are served from ./music
  //  - only /api/* runs the Worker code in ./worker (secure YouTube search)
  // The name must match the Worker name in Cloudflare.
  "name": "missing-music",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./music",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": false,
  "preview_urls": false,
  // Attach the custom domain on deploy (Cloudflare creates the DNS record and certificate).
  "routes": [
    { "pattern": "music.missing.website", "custom_domain": true }
  ]
  // Secret (set in the Cloudflare dashboard, never in this file): YOUTUBE_API_KEY
}
