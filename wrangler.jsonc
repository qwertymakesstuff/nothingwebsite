{
  // Cloudflare Worker "missing-music": serves the static music player from ./music
  // at music.missing.website. The name must match the Worker name in Cloudflare.
  "name": "missing-music",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./music"
  },
  // Attach the custom domain on deploy (Cloudflare creates the DNS record and certificate).
  "routes": [
    { "pattern": "music.missing.website", "custom_domain": true }
  ]
}
