{
  // Cloudflare Worker "simpleplay" (simple.missing.website): PUMPED in its simple view.
  // In Cloudflare (Workers & Pages > simpleplay > Settings > Build): Root directory = simpleplay
  // The Worker's name in Cloudflare must match the name below.
  //
  // The static files are the game itself (../pumped), so there is nothing to copy or rebuild:
  // the page switches to the simple view because the hostname starts with "simple.".
  "name": "simpleplay",
  "main": "./worker.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "../pumped",
    "binding": "ASSETS"
  },
  "workers_dev": false,
  "preview_urls": false,
  // Attach the custom domain on deploy (Cloudflare creates the DNS record and certificate).
  "routes": [
    { "pattern": "simple.missing.website", "custom_domain": true }
  ]
}
